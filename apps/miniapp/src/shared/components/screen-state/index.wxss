.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 64rpx 24rpx;
  color: #64748b;
  text-align: center;
  font-size: 28rpx;
}
.state-title {
  font-weight: 600;
  color: #0f172a;
}
.state-icon {
  font-size: 64rpx;
  color: #93b4f4;
}
.state button {
  background: #eff6ff;
  color: #2563eb;
}
.skeleton {
  padding: 24rpx 0;
}
.skeleton view {
  height: 100rpx;
  margin: 20rpx 0;
  border-radius: 24rpx;
  background: linear-gradient(100deg, #e8edf4, #f7f9fc, #e8edf4);
  background-size: 200% 100%;
  animation: pulse 1.5s infinite;
}
@keyframes pulse {
  to {
    background-position: -200% 0;
  }
}
