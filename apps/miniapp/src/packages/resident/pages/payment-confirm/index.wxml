<view class="screen"><view class="title">确认缴费</view><screen-state loading="{{loading}}" error="{{error}}" bind:retry="load"/><view wx:if="{{item}}" class="card"><view class="address">{{item.house_label_snapshot}}</view><view>{{item.billing_month}} 物业费</view><view class="muted">收款物业：{{item.property_company_name}}</view><view class="title">本次缴纳 ¥{{amount}}</view><view class="notice">一次付清本张账单全部待缴金额。请核对房屋、账期和收款物业。</view><view class="muted">{{hint}}</view><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || loading || !canPay}}">确认并处理支付</button></view></view>
