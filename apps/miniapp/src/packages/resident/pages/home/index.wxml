<app-shell tabs="{{tabs}}" refreshable refreshing="{{loading}}" bindrefresh="onPullDownRefresh" title="美好社区" tab="home">
  <state-view loading="{{loading && !loaded}}" error="{{error}}" bindretry="load" />
  <block wx:if="{{loaded}}">
    <view class="xp-home-heading"><button class="xp-location" bindtap="openPicker"><view class="home-location-mark"><ui-icon name="{{selected ? 'map-pin' : 'house'}}" size="36" /></view><view class="home-location-copy"><text class="home-location-title">{{selected ? selected.community : '美好社区'}}</text><text class="xp-caption">{{selected ? selected.room : '安心相邻，简单生活'}}</text></view><ui-icon wx:if="{{available.length > 1}}" name="chevron-down" size="32" /></button><button class="home-avatar" aria-label="个人中心" bindtap="profile"><ui-icon name="user-round" size="42" /></button></view>
    <view wx:if="{{selected}}" class="xp-bill-overview"><view class="xp-row"><view class="home-bill-label"><view class="home-bill-mark"><ui-icon name="receipt-text" size="34" /></view><text>待缴物业费</text></view><text wx:if="{{!summaryLoading && !summaryError}}" class="xp-tag {{billCount ? 'wait' : 'ok'}}">{{billCount ? '待处理' : '已结清'}}</text></view><state-view loading="{{summaryLoading}}" error="{{summaryError}}" bindretry="load" /><block wx:if="{{!summaryLoading && !summaryError}}"><view class="home-amount"><text>¥</text>{{amount}}</view><view class="xp-row"><text class="xp-caption">{{billCount ? billCount + ' 笔账单' + (overdue ? ' · 含历史欠费' : '') : '当前房屋暂无待缴账单'}}</text><button class="xp-link" bindtap="bills">查看账单 <ui-icon name="arrow-up-right" size="28" /></button></view></block></view>
    <view wx:else class="home-welcome"><text class="home-kicker">生活服务，从家开始</text><text class="home-welcome-title">{{pending.length ? '你的认领，正在审核' : bindingCount ? '回到熟悉的生活' : '把生活，安放在这里'}}</text><text class="xp-sub">{{pending.length ? pending[0].community + ' · ' + pending[0].room + '\n物业核实后，将为你开通房屋服务。' : bindingCount ? '本人缴费记录继续保留。重新使用房屋服务，请再次认领。' : '连接你的房屋，轻松管理物业账单与认领进度。'}}</text><view class="xp-actions"><button class="xp-button" bindtap="{{pending.length ? 'pendingDetail' : 'claim'}}">{{pending.length ? '查看审核进度' : signed ? '认领我的房屋' : '微信登录'}}</button></view></view>
    <view class="home-shortcuts"><button class="home-shortcut" bindtap="claims"><view class="home-shortcut-icon yellow"><ui-icon name="clipboard-list" size="38" /></view><text>认领申请</text></button><button class="home-shortcut" bindtap="orders"><view class="home-shortcut-icon blue"><ui-icon name="history" size="38" /></view><text>缴费记录</text></button></view>
    <button wx:if="{{pending.length}}" class="xp-listbutton home-progress" bindtap="claims"><view class="home-progress-icon"><ui-icon name="clock-3" size="36" /></view><view class="home-progress-copy"><text>认领申请待审核</text><text class="xp-caption">{{pending.length}} 项申请，随时查看进度</text></view><ui-icon name="chevron-right" size="32" /></button>
    <block wx:if="{{selected}}"><view class="xp-section-head"><text class="xp-h2">当前房屋</text><button class="xp-link" bindtap="houses">管理</button></view><button class="xp-listbutton home-house" bindtap="houseDetail"><view><text class="xp-caption">{{selected.community}}</text><text class="home-house-room">{{selected.room}}</text><text class="home-house-service">房屋服务已开通</text></view><ui-icon name="chevron-right" size="32" /></button></block>
    <text class="xp-legal home-signature">让每一笔缴费，都清清楚楚</text>
  </block>
</app-shell>
<house-picker open="{{picker}}" mode="switch" selected-id="{{selected ? selected.id : ''}}" bindings="{{available}}" bindconfirm="selectHouse" bindclose="closePicker" />
