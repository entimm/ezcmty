.xp-home-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.xp-location {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 44px;
  min-height: max(44px, 96rpx);
  background: none;
  padding: 0;
  flex: 1;
  min-width: 0;
  text-align: left;
}
.home-location-copy {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}
.home-location-title {
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.4;
  word-break: break-all;
}
.home-location-mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: #fff0b8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.home-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  color: #252b25;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  flex-shrink: 0;
  min-height: 44px;
  min-width: 44px;
}
.xp-bill-overview {
  background: #fff;
  padding: 28rpx 32rpx 16rpx;
  border-radius: 32rpx;
}
.home-bill-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
}
.home-bill-mark {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eaf3fa;
  color: #537b96;
}
.home-amount {
  font-size: 68rpx;
  font-weight: 500;
  line-height: 1.3;
  margin: 16rpx 0 12rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: -2rpx;
}
.home-amount > text {
  font-size: 36rpx;
  margin-right: 10rpx;
  font-weight: 400;
}
.home-welcome {
  background: #fff;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
}
.home-kicker {
  font-size: 24rpx;
  color: #8f7625;
  display: block;
}
.home-welcome-title {
  font-size: 44rpx;
  display: block;
  font-weight: 500;
  margin-top: 16rpx;
  line-height: 1.45;
}
.home-welcome .xp-sub {
  display: block;
  white-space: pre-line;
}
.home-shortcuts {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.home-shortcut {
  flex: 1;
  min-width: 0;
  min-height: 116rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-radius: 28rpx;
  background: #fff;
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
  text-align: left;
}
.home-shortcut-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.yellow {
  background: #fff2c2;
  color: #8a711c;
}
.blue {
  background: #eaf3fa;
  color: #537b96;
}
.home-progress {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
}
.home-progress-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}
.home-progress-icon {
  color: #a57d1c;
}
.home-house {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 0;
  padding: 26rpx 28rpx;
}
.home-house-room {
  font-size: 30rpx;
  font-weight: 500;
  display: block;
  margin-top: 6rpx;
}
.home-house-service {
  font-size: 23rpx;
  color: #7b8387;
  display: block;
  margin-top: 12rpx;
}
.home-signature {
  margin-top: 28rpx;
}

.home-shortcut:first-child .home-shortcut-icon {
  background: #fff0e3;
  color: #946440;
}
