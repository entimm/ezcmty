<view class="screen"><screen-state loading="{{loading}}" error="{{error}}" bind:retry="load"/><view wx:if="{{item}}" class="card"><view class="title">{{label}}</view><view class="notice" wx:if="{{message}}">{{message}}</view><view class="title">¥{{amount}}</view><view>收款物业：{{item.merchant_name}}</view><view class="muted">订单号：{{item.order_no}}</view><view wx:for="{{item.items}}" wx:key="id" class="tap-row">{{item.house_label_snapshot}} · {{item.billing_month}} 物业费</view><view wx:if="{{paid}}">支付时间：{{paid}}</view><button wx:if="{{canPay}}" class="primary" data-action="pay" bindtap="act" loading="{{busy}}" disabled="{{busy || loading}}">继续原支付</button><button wx:if="{{canRefresh}}" class="quiet" data-action="refresh" bindtap="act" disabled="{{busy || loading}}">核实缴费结果</button><button wx:if="{{canClose}}" class="quiet" data-action="close" bindtap="act" disabled="{{busy || loading}}">核实并关闭原订单</button><view wx:if="{{!canPay && item.status !== 'succeeded' && item.status !== 'closed'}}" class="notice">{{item.confirmation_status === 'awaiting_posting' ? '收款已确认，正在完成入账' : '当前不可再次支付，请核实原订单结果'}}</view><button wx:if="{{item.status === 'closed'}}" class="quiet" bindtap="backToBill">返回账单重新读取余额</button></view></view>
