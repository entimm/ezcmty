.xp-house-picker {
  margin-top: 0;
  padding: 22rpx 28rpx;
}
.xp-house-picker .xp-address {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.6;
  min-width: 0;
  text-align: left;
  word-break: break-all;
}
.bill-house-copy {
  flex: 1;
  min-width: 0;
}
.xp-house-picker .xp-address-sub {
  font-size: 26rpx;
  line-height: 1.55;
  margin-top: 2rpx;
  color: #646d5e;
  word-break: break-all;
}
.xp-house-picker ui-icon {
  flex-shrink: 0;
}
.xp-bill-summary {
  font-size: 24rpx;
  min-height: 88rpx;
  color: #646d5e;
}
.xp-bill-summary > text {
  min-width: 0;
}
.xp-bill-list {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  margin-top: 4rpx;
}
.xp-bill-item {
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: center;
  min-height: 200rpx;
  padding: 24rpx 28rpx;
  text-align: left;
  background: transparent;
  color: #252b25;
  border: 0;
  border-radius: 0;
}
.xp-bill-item + .xp-bill-item {
  border-top: 2rpx solid #e5e7df;
}
.xp-bill-copy {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}
.bill-month {
  font-size: 30rpx;
  font-weight: 500;
}
.xp-bill-copy .xp-caption {
  line-height: 1.5;
}
.xp-bill-due {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}
.bill-amount {
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}
.bill-more {
  margin: 12rpx auto 0;
}
.xp-bill-summary .xp-link {
  flex-shrink: 0;
}
