<app-shell refreshable="{{signed}}" refreshing="{{loading}}" bindrefresh="onPullDownRefresh" title="我的房屋" tab="houses">
  <state-view wx:if="{{!signed}}" empty title="登录后继续" description="微信登录即可使用本人服务，手机号按需授权。" action-text="微信登录" icon="user-round" bindaction="signIn" />
  <block wx:else>
  <view class="xp-tabs"><button class="{{filter === 'active' ? 'active' : ''}}" bindtap="selectFilter" data-filter="active">当前房屋</button><button class="{{filter === 'history' ? 'active' : ''}}" bindtap="selectFilter" data-filter="history">历史记录</button></view>
  <state-view loading="{{loading && !loaded}}" error="{{error}}" bindretry="load" />
  <block wx:if="{{loaded}}"><button wx:for="{{rows}}" wx:key="id" class="xp-listbutton house-tile" bindtap="open" data-id="{{item.id}}"><view class="xp-row"><text class="xp-address">{{item.community}}</text><view class="house-glyph"><ui-icon name="building-2" size="42" /></view></view><text class="xp-address-sub">{{item.room}}</text><view class="house-footer"><text class="xp-tag {{item.tone}}">{{item.statusText}}</text><view class="house-detail-link"><text>房屋详情</text><ui-icon name="chevron-right" size="28" /></view></view></button><state-view empty="{{!rows.length}}" title="{{filter === 'active' ? '还没有可用房屋' : '暂无历史授权'}}" description="{{filter === 'active' ? '认领后由物业人工核实，通过后即可开通房屋服务。' : '已结束的授权会保留在这里。'}}" action-text="{{filter === 'active' ? '认领房屋' : '查看当前房屋'}}" bindaction="{{filter === 'active' ? 'claim' : 'showCurrent'}}" /></block>
  <view class="xp-actions"><button class="xp-button" bindtap="claim">＋ 认领房屋</button></view>
  </block>
</app-shell>
