<view class="screen"><screen-state loading="{{loading}}" error="{{error}}" bind:retry="load"/>
<block wx:if="{{item}}"><view class="card"><text class="badge {{item.status}}">{{label}}</text><view class="title" style="margin-top:24rpx">{{item.status === 'pending' ? '申请已送达物业' : label}}</view><view class="subtitle">{{item.status === 'pending' ? '物业正在核实你的资料，审核后即可绑定房屋。' : '你可以在这里查看此次认领的完整记录。'}}</view></view>
<view class="card"><view class="address">{{item.house_label_snapshot}}</view><view class="separator"/><view class="row"><text class="muted">申请人</text><text>{{item.applicant_name}}</text></view><view class="row" style="margin-top:20rpx"><text class="muted">联系号码</text><text>{{phone}}</text></view><view wx:if="{{item.applicant_remark}}" class="notice">{{item.applicant_remark}}</view></view>
<view class="card"><view class="section-title" style="margin-top:0">申请进度</view><view class="timeline"><view><view>申请已提交</view><text class="muted">{{created}}</text></view><view wx:if="{{reviewed}}"><view>{{label}}</view><text class="muted">{{reviewed}}</text><view wx:if="{{item.review_reason}}" class="notice">物业说明：{{item.review_reason}}</view></view><view wx:elif="{{cancelled}}"><view>你已撤回申请</view><text class="muted">{{cancelled}}</text></view><view wx:else><view>等待物业审核</view><text class="muted">所有认领申请均由物业人工核实</text></view></view></view>
<view class="footer"><button wx:if="{{item.status === 'pending'}}" class="danger" bindtap="cancel" loading="{{busy}}" disabled="{{busy}}">撤回申请</button><button wx:elif="{{item.status === 'rejected' || item.status === 'cancelled'}}" class="primary" bindtap="again">重新认领</button><button wx:else class="primary" bindtap="houses">查看我的房屋</button></view></block></view>
