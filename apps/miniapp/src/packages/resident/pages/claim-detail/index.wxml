<app-shell refreshable refreshing="{{loading}}" bindrefresh="onPullDownRefresh" title="申请详情">
  <state-view loading="{{loading && !claim}}" error="{{error}}" bindretry="load" />
  <block wx:if="{{claim}}"><view class="xp-result"><view class="xp-result-mark {{claim.tone}}"><ui-icon name="{{claim.icon}}" size="48" /></view><text class="xp-h1">{{claim.title}}</text><text class="xp-sub">{{claim.description}}</text></view><view class="xp-card"><text class="xp-address">{{claim.community}}</text><text class="xp-address-sub">{{claim.room}}</text><view class="xp-divider"></view><view class="xp-info"><view class="xp-row"><text>申请人</text><text>{{claim.applicant_name}}</text></view><view class="xp-row"><text>联系手机号</text><text>{{claim.phone}}</text></view><view class="xp-row"><text>提交时间</text><text>{{claim.created}}</text></view></view><block wx:if="{{claim.applicant_remark}}"><view class="xp-divider"></view><text class="xp-muted">{{claim.applicant_remark}}</text></block></view><view wx:if="{{claim.status === 'rejected' && claim.review_reason}}" class="xp-notice warn">物业反馈：{{claim.review_reason}}</view><view class="xp-card"><text class="xp-h3">处理进度</text><view class="claim-timeline"><view class="claim-event active"><text>申请已提交</text><text class="xp-caption">{{claim.created}}</text></view><view class="claim-event {{claim.status !== 'pending' ? 'active' : ''}}"><text>{{claim.status === 'pending' ? '等待物业人工审核' : claim.title}}</text><text class="xp-caption">{{claim.status === 'pending' ? '所有认领均人工核实，审核通过后开通房屋服务' : claim.finished}}</text></view></view></view><text wx:if="{{actionError && !confirming}}" class="xp-field-error">{{actionError}}</text><view class="xp-actions"><button wx:if="{{claim.status === 'pending'}}" class="xp-button xp-neutral" disabled="{{busy}}" bindtap="withdraw">撤回申请</button><button wx:elif="{{claim.status === 'approved'}}" class="xp-button" disabled="{{busy}}" bindtap="binding">查看房屋授权</button><button wx:else class="xp-button" bindtap="reclaim">重新申请</button><button class="xp-button xp-secondary" bindtap="home">返回首页</button></view></block>
</app-shell>
<bottom-sheet show="{{confirming}}" title="撤回本次认领申请？" confirm-text="确认撤回" cancel-text="继续等待" busy="{{busy}}" bindconfirm="confirmWithdraw" bindclose="close"><text class="xp-muted">撤回后本次审核将结束。如仍需开通房屋服务，可重新发起申请。</text><text wx:if="{{actionError}}" class="xp-field-error">{{actionError}}</text></bottom-sheet>
