<view class="screen"><view class="eyebrow">MAKE IT YOUR HOME</view><view class="title">{{step === 1 ? '找到你的家' : step === 2 ? '填写认领资料' : '确认认领申请'}}</view><view class="subtitle">第 {{step}} 步 / 共 3 步　·　{{step === 1 ? '从小区开始，逐步选择房屋' : step === 2 ? '准确的资料，让物业核实更顺利' : '提交后，由物业人工审核'}}</view><view class="steps"><view class="done"/><view class="{{step >= 2 ? 'done' : ''}}"/><view class="{{step === 3 ? 'done' : ''}}"/></view>
<view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
<block wx:if="{{step === 1}}">
  <view wx:if="{{!community}}" class="card"><input placeholder="搜索你的小区" value="{{communityQuery}}" bindinput="communityInput" bindconfirm="search" confirm-type="search"/><button class="quiet" bindtap="search" disabled="{{loading}}">搜索小区</button><view wx:for="{{communityResults}}" wx:key="id" class="tap-row" data-id="{{item.id}}" bindtap="selectCommunity"><view class="row"><text>{{item.name}}</text><text class="chevron">›</text></view><text class="muted">{{item.address}}</text></view></view>
  <block wx:else><view class="card"><view class="row"><text class="address">{{community.name}}</text><text class="tiny-link" bindtap="changeCommunity">更换</text></view><view style="margin-top:20rpx"><text class="crumb" data-index="-1" bindtap="breadcrumb">全部空间</text><text wx:for="{{trail}}" wx:key="id" class="crumb" data-index="{{index}}" bindtap="breadcrumb">{{item.name}}</text></view></view>
    <view wx:if="{{nodes.length}}" class="card"><view class="muted">选择楼栋 / 单元</view><view wx:for="{{nodes}}" wx:key="id" class="tap-row row" data-id="{{item.id}}" bindtap="selectNode"><text>{{item.name}}</text><text class="chevron">›</text></view></view>
    <view wx:if="{{trail.length}}" class="card"><view class="muted">当前空间的房屋</view><view class="row" style="margin-top:20rpx"><input placeholder="搜索房号" value="{{roomQuery}}" bindinput="roomInput" bindconfirm="search" confirm-type="search"/><button class="quiet" size="mini" bindtap="search">查找</button></view><view wx:for="{{houses}}" wx:key="id" class="tap-row row" data-id="{{item.id}}" bindtap="selectHouse"><text>{{item.room_no}} 室</text><text class="tiny-link">选择 →</text></view></view>
  </block>
  <screen-state loading="{{loading}}" empty="{{!loading && !error && ((!community && !communityResults.length) || (community && !nodes.length && !houses.length))}}" message="暂未找到房屋，请联系物业补充资料"/>
  <button wx:if="{{(!community && communityResults.length < communityTotal) || (community && (nodes.length < nodeTotal || houses.length < houseTotal))}}" class="quiet" bindtap="more" loading="{{loading}}">加载更多</button>
  <button wx:if="{{error}}" class="secondary" bindtap="retry">重新加载</button>
  <view class="hint" style="text-align:center">房屋由物业维护，未找到时请联系物业。</view>
</block>
<block wx:elif="{{step === 2}}">
  <view class="card"><text class="badge">已选房屋</text><view class="address" style="margin-top:20rpx">{{house.display_address}}</view></view>
  <view class="card"><view class="field"><text class="label">你的姓名</text><input value="{{name}}" maxlength="80" placeholder="请输入业主姓名" bindinput="nameInput"/></view><view class="field"><view class="row"><text class="label">联系手机号</text><text class="tiny-link" bindtap="addPhone">＋ 添加号码</text></view><screen-state loading="{{loading}}"/><view wx:for="{{phones}}" wx:key="id" class="selection row {{phoneId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectPhone"><text>{{item.display_phone}}</text><text class="badge">{{phoneId === item.id ? '已选择' : '已验证'}}</text></view><button wx:if="{{!loading && !phones.length}}" class="secondary" bindtap="addPhone">验证并添加手机号</button></view><view class="field"><text class="label">补充说明 <text class="muted">（选填）</text></text><textarea value="{{remark}}" maxlength="1000" placeholder="有助于物业核实的信息" bindinput="remarkInput"/></view></view>
  <view class="sticky stack"><button class="primary" bindtap="next" disabled="{{loading}}">下一步，确认信息</button><button class="quiet" bindtap="back">重新选择房屋</button></view>
</block>
<block wx:else>
  <view class="card"><view class="address">{{house.display_address}}</view><view class="separator"/><view class="row"><text class="muted">申请人</text><text>{{name}}</text></view><view class="row" style="margin-top:24rpx"><text class="muted">已验证号码</text><text>{{phoneDisplay}}</text></view><view wx:if="{{remark}}" class="notice">{{remark}}</view></view>
  <view class="notice">提交后，物业将人工核实你的房屋归属。审核通过后即可绑定房屋；审核前可以撤回申请。</view>
  <view class="sticky stack"><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{unknown ? '重试，确认提交结果' : '提交认领申请'}}</button><button wx:if="{{!unknown}}" class="quiet" bindtap="back" disabled="{{busy}}">返回修改</button><button wx:else class="quiet" bindtap="applications">查看我的申请</button></view>
</block></view>
