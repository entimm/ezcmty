<app-shell refreshable refreshing="{{loading}}" bindrefresh="onPullDownRefresh" title="房屋详情">
  <state-view loading="{{loading && !binding}}" error="{{error}}" bindretry="load" />
  <block wx:if="{{binding}}"><text class="xp-tag {{binding.tone}}">{{binding.statusText}}</text><view class="xp-gap"></view><text class="xp-h1">{{binding.community}}</text><text class="xp-sub">{{binding.room}}</text><view class="xp-card"><view class="xp-info"><view class="xp-row"><text>房屋授权</text><text>{{binding.history ? '已结束' : '物业审核通过'}}</text></view><view class="xp-row"><text>绑定时间</text><text>{{binding.granted}}</text></view><view wx:if="{{binding.history}}" class="xp-row"><text>结束时间</text><text>{{binding.ended}}</text></view></view><block wx:if="{{binding.end_reason}}"><view class="xp-divider"></view><text class="xp-muted">{{binding.end_reason}}</text></block></view><view class="xp-notice {{!binding.enabled && !binding.history ? 'warn' : ''}}">{{binding.history ? '无法继续查看该房屋账单或付款；本人历史缴费记录保留。' : !binding.enabled ? '房屋服务暂不可用，请联系物业核实。已有授权与历史记录保留。' : '房屋授权由物业审核确认；解绑手机号不会取消已获房屋授权。'}}</view><view class="xp-actions"><button wx:if="{{binding.history}}" class="xp-button" bindtap="reclaim">重新认领此房屋</button><button wx:else class="xp-button" bindtap="bills" disabled="{{!binding.enabled}}">查看房屋账单</button><button class="xp-button xp-neutral" bindtap="orders">本人缴费记录</button><button wx:if="{{!binding.history}}" class="xp-button xp-danger" disabled="{{busy}}" bindtap="release">解绑房屋</button></view></block>
</app-shell>
<bottom-sheet show="{{confirming}}" title="确认解绑房屋？" confirm-text="确认解绑" cancel-text="暂不解绑" danger busy="{{busy}}" bindconfirm="confirmRelease" bindclose="close"><text class="xp-muted">解绑后将无法查看该房屋账单或继续付款。本人缴费记录仍会保留，再次使用需重新认领。</text><text wx:if="{{actionError}}" class="xp-field-error">{{actionError}}</text></bottom-sheet>
