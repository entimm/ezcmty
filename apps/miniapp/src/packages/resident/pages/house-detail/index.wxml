<view class="screen"><screen-state loading="{{loading}}" error="{{error}}" bind:retry="load"/>
<block wx:if="{{item}}"><view class="card"><text class="badge {{item.status}}">{{label}}</text><view class="title" style="margin-top:24rpx">我的家</view><view class="address" style="margin-top:24rpx">{{item.house_label_snapshot}}</view><view wx:if="{{item.status === 'active' && !item.effective_enabled}}" class="notice">房屋或所属物业服务暂不可用，请联系物业了解详情。</view></view>
<view class="card"><view class="row"><text class="muted">绑定时间</text><text>{{granted}}</text></view><view wx:if="{{ended}}" class="row" style="margin-top:24rpx"><text class="muted">结束时间</text><text>{{ended}}</text></view><view wx:if="{{item.end_reason}}" class="notice">处理说明：{{item.end_reason}}</view></view>
<view class="footer"><button wx:if="{{item.status === 'active'}}" class="danger" bindtap="release" loading="{{busy}}" disabled="{{busy || loading || error}}">解绑房屋</button><button wx:else class="primary" bindtap="again">重新认领此房屋</button></view></block></view>
