<view class="screen"><view class="card hero"><view class="eyebrow">邻里生活 · 个人中心</view><view class="title" style="margin-top:24rpx">{{signedIn ? '很高兴与你相邻' : '欢迎，邻居'}}</view><view class="subtitle">照顾好你的每一份家的连接。</view></view>
<view class="card"><view class="tap-row row" data-url="/packages/resident/pages/houses/index" bindtap="open"><text>我的房屋</text><text class="chevron">›</text></view><view class="tap-row row" data-url="/packages/resident/pages/claims/index" bindtap="open"><text>认领申请</text><text class="chevron">›</text></view><view class="tap-row row" data-url="/pages/phones/index" bindtap="open"><text>我的手机号</text><text class="chevron">›</text></view></view>
<button wx:if="{{signedIn}}" class="quiet" bindtap="logout" loading="{{busy}}" disabled="{{busy}}">退出登录</button><button wx:else class="primary" bindtap="login">微信登录</button></view>
