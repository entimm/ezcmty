.profile-heading {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 12rpx 0 28rpx;
}
.profile-symbol {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eaf4ef;
  color: #467969;
  flex-shrink: 0;
}
.profile-title {
  font-size: 40rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}
.profile-services {
  display: flex;
  background: #fff;
  padding: 20rpx 12rpx;
  border-radius: 28rpx;
}
.profile-services > button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 132rpx;
  flex: 1;
  background: none;
  padding: 0;
  font-size: 26rpx;
}
.profile-service-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.yellow {
  background: #fff2c2;
  color: #8a711c;
}
.blue {
  background: #eaf3fa;
  color: #537b96;
}
.peach {
  background: #fbece4;
  color: #a9775e;
}
.profile-menu {
  padding: 0 28rpx;
}
.profile-menu > button {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 44px;
  min-height: max(44px, 100rpx);
  padding: 20rpx 0;
  font-size: 30rpx;
  text-align: left;
  background: none;
  border-bottom: 1rpx solid #eceeef;
}
.profile-menu > button:last-child {
  border: 0;
}
.profile-end {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-left: auto;
  color: #7b8387;
  font-size: 24rpx;
}
.profile-signature {
  margin-top: 32rpx;
}
.profile-help {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  color: #737b81;
  font-size: 28rpx;
  line-height: 1.7;
}
