<view class="screen"><view class="title">我的缴费记录</view><view class="muted">包含已解绑房屋及待确认的本人支付</view><view class="row"><button class="quiet" data-status="" bindtap="filter">全部</button><button class="quiet" data-status="succeeded" bindtap="filter">缴费成功</button><button class="quiet" data-status="unknown" bindtap="filter">结果待确认</button></view><screen-state loading="{{loading}}" error="{{error}}" bind:retry="retry" empty="{{!loading && !error && !items.length}}" message="暂无本人缴费记录"/><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row"><text>{{item.merchant_name}}</text><text>¥{{item.amount}}</text></view><view>{{item.items[0].house_label_snapshot}} · {{item.items[0].billing_month}}</view><view class="notice">{{item.label}}</view><text class="muted">{{item.order_no}} →</text></view><button wx:if="{{items.length < total}}" bindtap="more" disabled="{{loading}}">加载更多</button></view>
