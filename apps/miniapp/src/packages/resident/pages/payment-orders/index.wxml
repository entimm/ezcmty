<app-shell
  title="本人缴费记录"
  refreshable
  refreshing="{{loading}}"
  bindrefresh="onPullDownRefresh"
>
  <view class="xp-sub records-intro">解绑房屋后，自己的缴费记录仍保留</view>
  <view class="xp-tabs"
    ><button
      class="{{filter === 'all' ? 'active' : ''}}"
      data-filter="all"
      bindtap="filter"
    >
      全部</button
    ><button
      class="{{filter === 'success' ? 'active' : ''}}"
      data-filter="success"
      bindtap="filter"
    >
      已成功</button
    ><button
      class="{{filter === 'pending' ? 'active' : ''}}"
      data-filter="pending"
      bindtap="filter"
    >
      待确认
    </button></view
  >
  <state-view loading="{{loading}}" error="{{error}}" bindretry="retry" />
  <block wx:if="{{!loading && !error}}">
    <button
      wx:for="{{items}}"
      wx:key="id"
      class="xp-listbutton order-card"
      data-id="{{item.id}}"
      bindtap="open"
    >
      <view class="xp-row"
        ><text class="order-title">物业费缴纳</text
        ><text class="xp-tag {{item.labelTone}}">{{item.label}}</text></view
      ><view class="xp-address-sub">{{item.summary}}</view
      ><view class="xp-divider" /><view class="xp-row"
        ><text class="xp-caption">{{item.created}}</text
        ><text class="xp-amount-small">¥ {{item.amount}}</text></view
      >
    </button>
    <state-view
      wx:if="{{!items.length && !hasMore}}"
      empty
      title="{{filter === 'all' ? '暂无本人缴费记录' : '当前筛选下没有记录'}}"
      description="发起缴费后，可在这里查看订单与处理进度。"
      action-text="{{filter === 'all' ? '前往账单' : '查看全部记录'}}"
      bindaction="emptyAction"
    />
    <view wx:if="{{!items.length && hasMore}}" class="xp-notice"
      >已查看最近 {{scanned}} 笔记录，可继续查找待确认订单。</view
    >
    <view wx:if="{{moreError}}" class="xp-notice warn"
      >{{moreError}}<button class="xp-link" bindtap="more">
        重试加载
      </button></view
    >
    <button
      wx:if="{{hasMore}}"
      class="xp-link order-more"
      loading="{{moreLoading}}"
      disabled="{{moreLoading}}"
      bindtap="more"
    >
      {{moreLoading ? '正在加载…' : !items.length ? '继续查找待确认订单' :
      '加载更多记录'}}
    </button>
    <view wx:elif="{{items.length}}" class="xp-legal">已显示全部缴费记录</view>
  </block>
</app-shell>
