<app-shell refreshable refreshing="{{loading}}" bindrefresh="onPullDownRefresh" title="认领申请">
  <view class="xp-tabs"><button class="{{filter === 'all' ? 'active' : ''}}" bindtap="selectFilter" data-filter="all">全部</button><button class="{{filter === 'pending' ? 'active' : ''}}" bindtap="selectFilter" data-filter="pending">待审核</button><button class="{{filter === 'done' ? 'active' : ''}}" bindtap="selectFilter" data-filter="done">已完成</button></view>
  <state-view loading="{{loading && !loaded}}" error="{{error}}" bindretry="load" />
  <block wx:if="{{loaded}}"><button wx:for="{{rows}}" wx:key="id" class="xp-listbutton" bindtap="open" data-id="{{item.id}}"><view class="xp-row"><text class="xp-strong">{{item.community}}</text><text class="xp-tag {{item.tone}}">{{item.statusText}}</text></view><text class="xp-address-sub">{{item.room}}</text><view class="xp-divider"></view><view class="xp-row"><text class="xp-caption">{{item.created}} 提交</text><ui-icon name="chevron-right" size="32" /></view></button><state-view empty="{{!rows.length}}" title="{{filter === 'all' ? '暂无认领申请' : '当前筛选下没有申请'}}" description="提交后可查看物业人工审核进度。" action-text="{{filter === 'all' ? '开始认领' : '查看全部申请'}}" bindaction="{{filter === 'all' ? 'claim' : 'showAll'}}" /></block>
  <view class="xp-actions"><button class="xp-button xp-secondary" bindtap="claim">新建认领申请</button></view>
</app-shell>
