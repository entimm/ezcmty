<view class="screen"><screen-state loading="{{loading}}" error="{{error}}" bind:retry="load"/><block wx:if="{{item}}"><view class="card"><view class="title">{{item.billing_month}} 物业费</view><view class="address">{{item.house_label_snapshot}}</view><view class="muted">收款物业：{{item.property_company_name}}</view><view class="muted">{{item.period_start}} 至 {{item.period_end}}</view><view class="row"><text>应收 ¥{{amount}}</text><text>已缴 ¥{{settled}}</text></view><view class="title">待缴 ¥{{outstanding}}</view><view wx:if="{{item.is_overdue}}" class="notice">历史欠费</view><view class="notice">{{hint}}</view><button class="primary" bindtap="pay" disabled="{{!canPay || loading}}">{{canPay ? '前往缴费' : '暂不可缴费'}}</button></view>
<view class="card"><view class="section-title">收款流水</view><screen-state loading="{{entryLoading}}" error="{{entryError}}" bind:retry="retryEntries"/><view wx:for="{{entries}}" wx:key="id" class="tap-row"><view class="row"><text>{{item.label}}</text><text>¥{{item.amount}}</text></view><text class="muted">{{item.received}}</text></view><view wx:if="{{!entryLoading && !entries.length}}" class="muted">暂无收款记录</view><button wx:if="{{entries.length < entryTotal}}" bindtap="more" disabled="{{entryLoading}}">更多流水</button></view></block></view>
