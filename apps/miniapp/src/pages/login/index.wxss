.login-page {
  text-align: center;
  padding: 12rpx 14rpx 36rpx;
}
.login-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  font-size: 30rpx;
  color: #646d5e;
}
.login-brand-mark {
  width: 58rpx;
  height: 58rpx;
  border-radius: 20rpx;
  background: #f7e679;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-illustration {
  width: 168rpx;
  height: 168rpx;
  border-radius: 52rpx;
  background: #fff7cd;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin: 48rpx auto 36rpx;
}
.login-heart {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  background: #f7e679;
  width: 58rpx;
  height: 58rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-title {
  font-size: 50rpx;
  line-height: 1.4;
  font-weight: 500;
}
.login-page .xp-sub {
  margin-top: 20rpx;
  line-height: 1.7;
}
.login-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 48rpx;
}
.login-signature {
  font-size: 24rpx;
  color: #646d5e;
  margin-top: 48rpx;
  letter-spacing: 2rpx;
}
.sheet-paragraph {
  margin-top: 14rpx;
}
