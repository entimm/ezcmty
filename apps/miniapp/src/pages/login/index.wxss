.login-screen {
  padding-top: 100rpx;
  background: radial-gradient(ellipse at top right, #e2ecff, transparent 65%);
  min-height: 100vh;
}
.welcome-mark {
  width: 124rpx;
  height: 124rpx;
  border-radius: 36rpx;
  background: #2563eb;
  color: white;
  text-align: center;
  line-height: 124rpx;
  font-size: 84rpx;
  margin-bottom: 40rpx;
}
.welcome-title {
  font-size: 56rpx;
  font-weight: 750;
  line-height: 1.4;
  margin-top: 24rpx;
  letter-spacing: -2rpx;
}
.login-card {
  margin-top: 72rpx;
}
.login-card .section-title {
  margin-top: 0;
}
.login-card button {
  margin-top: 36rpx;
}
.login-card .hint {
  text-align: center;
  margin-top: 24rpx;
}
