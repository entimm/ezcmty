{
  "name": "community-property-platform",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api:lint": "redocly lint docs/api/openapi/openapi.yaml",
    "api:bundle": "redocly bundle docs/api/openapi/openapi.yaml --output build/openapi/openapi.bundled.json",
    "api:contract": "uv run --project services/backend python scripts/check_api_contract.py",
    "api:check": "pnpm api:lint && pnpm api:bundle && pnpm api:contract",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.0",
    "prettier": "^3.5.0"
  }
}
