APP_NAME=Community Property Platform
APP_ENV=local
APP_DATABASE_URL=postgresql+psycopg://platform:change-me@127.0.0.1:5432/community_platform
APP_REDIS_URL=redis://127.0.0.1:6379/0
APP_SESSION_TTL_SECONDS=86400
APP_ADMIN_SESSION_IDLE_SECONDS=1800
APP_ADMIN_SESSION_ABSOLUTE_SECONDS=43200
APP_ADMIN_TRUSTED_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'
APP_PLATFORM_ADMIN_COOKIE_PATH=/api/platform
APP_PROPERTY_ADMIN_COOKIE_PATH=/api/property
APP_ADMIN_LOGIN_LIMIT=5
APP_ADMIN_LOGIN_WINDOW_SECONDS=900
APP_LOG_LEVEL=INFO
